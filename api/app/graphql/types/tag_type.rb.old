module Types
    class TagType < ::Types::BaseObject
        # Type pouvant servir pour toutes les tables paramètres
        field :value, ID, null: false
        field :label, ID, null: false

        def value
            object.id
        end

        def label
            if object.is_a?Physical::Port 
               "#{object.chassis.name} -- #{object.name}" 
            else
                object.name 
            end
        end

    end
end