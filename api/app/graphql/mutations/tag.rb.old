module Mutations
  class Tag < ::Mutations::BaseMutation
    
    argument :class_name, String, required: true
    argument :id, ID, required: false
    argument :name, String, required: true

    type ::Types::TagType

    def resolve(**args)
      klass = args[:class_name].constantize

      args.delete(:class_name)
      return baseResolver(klass, args)
    end
  end
end