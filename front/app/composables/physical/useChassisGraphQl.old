import Q_CHASSIS from '@/graphql/physical/chassis.query.gql'
import CHASSIS from '@/graphql/physical/chassis.mutation.gql'
import DELETE_CHASSIS from '@/graphql/physical/deleteChassis.mutation.gql'
import { useMutation } from '@vue/apollo-composable'
import type { ChassisType } from '@/types/physical/chassis'

export const useChassisGraphQl = () => {
     
    // Defaults Callback
    const defaultOnSuccess = (value: ChassisType | number | string ): void => {console.log(value)}
    const defaultOnError = (graphQLErrors: any, networkError: any): void => {
        console.log(graphQLErrors)
        console.log(networkError)
    }

    // Mutation
    const useCreateOrUpdateChassis = (
        onSuccess: (value: ChassisType) => void = defaultOnSuccess,
        onError: (invalideRecord: any[], networkError: any) => void = defaultOnError
    ) => {

        const mutateChassis = (value: ChassisType) => {
            
            const { mutate, onDone, onError: onMutationError } = useMutation(
                CHASSIS, { 
                    update: (cache) => {
                        // On supprime toutes les query chassis en cache
                        // Les queries en cours d'utilisation sont refetechés
                        const rootQuery = cache.data.data.ROOT_QUERY
                        Object.keys(rootQuery).forEach((key) => {
                            if (useStartsWith(key, 'chassis(') || useStartsWith(key, 'availablePorts')) {
                                // En faisant cela on update le cache
                                cache.evict({ id: "ROOT_QUERY", fieldName: key })
                            }
                        })
                        // On fait un garbage collector pour supprimer les références non utilisées
                        cache.gc()
                    }
                    // refetchQueries: () => value?.id == undefined ? ['chassis'] : [],
            })

            onDone(({ data }) => onSuccess(data['chassis']))

            onMutationError(({ graphQLErrors, networkError }) => onError(
                useReduce(graphQLErrors, (result, value) => {
                    if (value?.invalid_record) result.push(value.invalid_record)
                    return result
                }, []),
                networkError))

                mutate({input: value})
        }

        return mutateChassis
    }

    // Delete
    const useDeleteChassis = (
        onSuccess: (value: number|string) => void = defaultOnSuccess,
        onError: (graphQLErrors: any, networkError: any) => void = defaultOnError
    ) => {
        const { mutate, onDone, onError: onMutationError } = useMutation(
            DELETE_CHASSIS, {
            update: (cache, { data }) => {
                // On recupére l'id normalizé du chassis_class deleté
                const deletedChassisRef = cache.identify({ id: data.deleteChassis.deletedId, __typename: 'Chassis' })
                cache.modify({
                    fields: {
                        // On le supprime de toutes les query chassis
                        chassis: (existingChassis) => {
                            return existingChassis.filter(chassisRef => {
                                return cache.identify(chassisRef) !== deletedChassisRef
                            })
                        }
                    },
                    // On prévient un refetch
                    broadcast: false
                })
                // Enfin on supprime l'objet normalizé 
                cache.evict({ id: deletedChassisRef })
            }
        })

        onDone(({ data }) => onSuccess(data.deleteChassis.deletedId))

        onMutationError(({ graphQLErrors, networkError }) => onError(graphQLErrors, networkError))

        return mutate
    }

    return { useCreateOrUpdateChassis, useDeleteChassis }

}