const isUnauthorized = (error: any) => {
  return (
    error?.statusCode === 401 ||
    error?.networkError?.statusCode === 401 ||
    error?.message === '401 Unauthorized'
  )
}

export default defineNuxtRouteMiddleware(async (to) => {
  const config = useRuntimeConfig()
  const CAS_URL = config.public.casUrl
  
  const urlOrigine = encodeURIComponent(useRequestURL().origin + to.path)

  const ticket = to.query.ticket
// const ticket = to.fullPath.match(/ST.+/)
  // Page publique
  if (to.path === '/' && !ticket) {
    return
  }

  const { checkAuth, userLogIn } = useUserAuth()

  // =============================================================
  // 1. Retour du CAS : on échange le ticket CAS contre notre JWT
  // =============================================================
  if (ticket) {
    try {
      await userLogIn({variables: {
            ticket: String(ticket),
            service: urlOrigine
    }})
      // Le JWT applicatif est maintenant dans authStore
      // On enlève le ticket de l'URL.
      return navigateTo(to.path, {
        replace: true
      })

    } catch (error) {
      console.error('CAS login failed', error)
      return navigateTo('/', {
        replace: true
      })
    }
  }

  // =========================================================
  // 2. Pas de ticket : on vérifie notre session applicative
  // =========================================================
  try {
    const user = await checkAuth()
    
    // JWT valide → on continue
    if (user) {
      return
    }

  } catch (error: any) {
    if (!isUnauthorized(error)) {
      // Erreur technique : API inaccessible, 500, timeout...
      console.error('Check auth failed', error)
      // return
    }
  }
  
  // =========================================================
  // 3. Pas authentifié → CAS
  // =========================================================

  // const service = urlOrigine + to.path

  return navigateTo(
    `${CAS_URL}/login?service=${urlOrigine}`,
    {
      external: true
    }
  )
})
