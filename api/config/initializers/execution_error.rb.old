class GraphQL::ExecutionError < GraphQL::Error
  attr_accessor :error, :record

  def initialize(error)
    @error = error
    @record = error.try(:record)
  end

  def to_h
    if record.present?
      { invalid_record: record.errors.messages.transform_values{|mes| mes.join(",")} }
    else
      { invalid_record: error }
    end
  end
end

