<template>
    <FormField :name="props.name" v-slot="{ handleChange }">
        <FormItem>
            <FormLabel>{{ props.label }}</FormLabel>
            <FormControl >
                <input 
                    :id="`upload-file-${props.name}`"
                    :ref="`upload-file-${props.name}`"
                    type="file"
                    placeholder="Select image ..."
                    @change="(e: Event) => { handleChange(e); handleFileChange(e) }"
                    hidden
                />
                <label v-if="imageName?.length == 0" :for="`upload-file-${props.name}`" :refs="`upload-file-${props.name}`">
                    Choisie une image ...
                </label>
                <div v-else class="flex justify-between">
                    <label :for="`upload-file-${props.name}`" :refs="`upload-file-${props.name}`">
                        {{ imageName }}
                    </label>
                    <Delete @click="removeFile(el as HTMLInputElement)"/>    
                </div>
                <NuxtImg v-if="imagePreview.length != 0" :src="el?.value == '' ? getImageUrl(imagePreview) : imagePreview" class="h-9 w-96"/>
            </FormControl>
            <FormMessage />
        </FormItem>
    </FormField>
</template>

<script setup lang="ts">
    // Icons
    import { Delete } from '@lucide/vue'

    // Props
    const props = defineProps<{
        label: string
        name: string
        value?: string
    }>()

    // Image Preview
    const imagePreview = ref<string>(props.value ?? "")
    const imageName = ref<string | undefined>(props.value ? props.value.split('/').at(-1) : "")

    const getImageUrl = (path: string) => {
        return new URL(path, import.meta.url).href
    }

    // Gestion de l'input File
    const el = useTemplateRef<HTMLInputElement>(`upload-file-${props.name}`)    

    const removeFile = (el: HTMLInputElement) => {
        el.value = imagePreview.value = imageName.value = ""
        el.dispatchEvent(new Event('change'))
    }

    const handleFileChange = (event: Event) => {  
        const target = event.target as HTMLInputElement

        if ( target.files && target.files[0]) {
            let file = target.files[0];
            imageName.value = file.name
            if(!file || file.type.indexOf('image/') === -1) return
            let reader = new FileReader()
            reader.onload = e => imagePreview.value = e.target?.result as string
            reader.readAsDataURL(file)
        }
    }    

</script>